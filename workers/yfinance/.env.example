# =============================================================================
# EyesInvest yfinance worker — environment variables
#
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# Supabase project URL (hosted or local CLI)
SUPABASE_URL=https://<project-ref>.supabase.co

# Service-role key (NOT the anon key). Required for write access — ey_*
# tables have RLS enabled so the anon key cannot upsert.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Optional — log level for loguru (default: INFO)
LOG_LEVEL=INFO

# Optional — years of daily bars to fetch per ticker (default: 3).
# 3y gives enough history for MA200, 1y return, 3y drawdown to populate.
# HISTORY_PERIOD_YEARS=3

# Optional — pause between ticker fetches, in seconds (default: 0.5).
# Bump if yfinance starts rate-limiting you.
# PRICE_THROTTLE_SECONDS=0.5

# Optional — calendar days of FINRA `regShoDaily` to pull per ticker
# (default: 90 ≈ 3 months of trading days). One POST per ticker covers
# the whole range, well under FINRA's 5,000-row per-call cap. Bump if
# you want a longer daily bar history on the chart.
# SHORT_SALE_HISTORY_DAYS=90

# ===========================================================================
# Phase 7 — News ingestion (sync-news)
# Hybrid approach: RSS feeds discover article URLs; the worker then
# fetches each article's full body via trafilatura before the LLM
# call. This gets the reliability of RSS (server-rendered, works from
# any IP) plus the rich text the LLM needs (full article body, not a
# 300-char RSS summary).
# ===========================================================================

# JSON list of RSS feeds to ingest. Each entry: {"name", "url", "market"}.
# `market` is informational (US|HK|GLOBAL); the LLM treats the universe
# uniformly. Empty list → sync-news is a no-op.
# Example:
#   NEWS_RSS_FEEDS=[{"name":"CNBC Top News","url":"https://www.cnbc.com/id/100003114/device/rss/rss.html","market":"US"}]
NEWS_RSS_FEEDS=

# Optional — when true (default), fetch each article's full body via
# the crawler and replace the RSS summary with it. Disable (set to
# "false") for the lighter RSS-only path: faster but the LLM gets less
# context per article.
# NEWS_CRAWL_BODY_ENABLED=true

# Optional — lookback window for each run, in hours (default: 48).
# Articles with determinable publish times older than this are skipped.
# NEWS_LOOKBACK_HOURS=48

# Optional — pause between article-body fetches, in seconds (default: 1.0).
# Be polite — datacenter IPs get rate-limited by most news sites fast.
# NEWS_THROTTLE_SECONDS=1.0

# Optional — hard cap on articles ingested per run (default: 200).
# Caps the LLM cost on the first sync after a long gap.
# NEWS_MAX_ARTICLES_PER_RUN=200

# ===========================================================================
# Phase 8 — AI analysis (sync-news Pass B)
# ===========================================================================

# OpenRouter API key. Get one at https://openrouter.ai/keys.
# Leave empty to fetch RSS + write articles only; the AI pass is skipped.
OPENROUTER_API_KEY=

# Model to use. Default is Anthropic Claude Haiku 4.5 (fastest, cheap).
# Switch to anthropic/claude-sonnet-4-5 for richer reasoning at ~5x cost.
OPENROUTER_MODEL=anthropic/claude-haiku-4-5

# Optional — OpenRouter base URL (default: https://openrouter.ai/api/v1).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional — pause between LLM calls, in seconds (default: 2.0).
# OPENROUTER_THROTTLE_SECONDS=2.0

# Optional — articles per LLM call (default: 5). 5 ≈ 2.5K input tokens.
# OPENROUTER_MAX_ARTICLES_PER_LLM_CALL=5
