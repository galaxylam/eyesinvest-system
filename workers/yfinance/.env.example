# =============================================================================
# EyesInvest yfinance worker — environment variables
#
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# Supabase project URL (hosted or local CLI)
SUPABASE_URL=https://<project-ref>.supabase.co

# Service-role key (NOT the anon key). Required for write access — ey_*
# tables have RLS enabled so the anon key cannot upsert.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Optional — log level for loguru (default: INFO)
LOG_LEVEL=INFO

# Optional — years of daily bars to fetch per ticker (default: 3).
# 3y gives enough history for MA200, 1y return, 3y drawdown to populate.
# HISTORY_PERIOD_YEARS=3

# Optional — pause between ticker fetches, in seconds (default: 0.5).
# Bump if yfinance starts rate-limiting you.
# PRICE_THROTTLE_SECONDS=0.5
