# =============================================================================
# EyesInvest — Environment Variables (placeholders only — copy to .env.local)
# =============================================================================
# Never commit real secrets. Use .env.local per app for actual values.

# ---------- Supabase (shared by web + admin + yfinance worker) ----------
# For supabase.com (hosted): https://<project-ref>.supabase.co
# For local Supabase CLI: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-only — never expose to the browser. Required for:
#   - apps/admin service-role client (writes bypass RLS)
#   - workers/yfinance Python worker (writes ey_price_1d, ey_quote_snapshot)
# Leave empty to keep apps in mock-data mode.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ---------- OpenRouter (Phase 8, placeholder for now) ----------
OPENROUTER_API_KEY=

# ---------- Application ----------
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=0.1.0
